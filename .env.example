# --- App ---
APP_URL=http://localhost:3000            # Vercel URL in prod, e.g. https://report-engine.vercel.app
SESSION_SECRET=                          # 32+ random chars; signs the session cookie
TOKEN_ENCRYPTION_KEY=                    # 32 bytes base64; encrypts stored refresh tokens (openssl rand -base64 32)
CRON_SECRET=                             # Vercel sends this as Bearer token to /api/sync

# --- id4 (MeasureSquare OAuth) ---
ID4_ISSUER=https://id4.measuresquare.com
ID4_CLIENT_ID=
ID4_CLIENT_SECRET=
ID4_SCOPES="openid profile email crm-api offline_access"
# Register redirect URI in id4: ${APP_URL}/api/auth/callback

# --- CRM API ---
CRM_API_BASE=https://crm11api.measuresquare.com

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=               # server-side only, never exposed to the browser
